{
  "name": "kr-job-parser",
  "version": "0.4.1",
  "description": "한국 채용공고의 경력·지역·마감 표기를 타입이 있는 구조화 데이터로 바꾸는 라이브러리",
  "keywords": [
    "korean",
    "job",
    "recruitment",
    "parser",
    "채용공고",
    "typescript"
  ],
  "license": "MIT",
  "author": "Kang heejun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coddddin/job-alert-hub.git",
    "directory": "packages/kr-job-parser"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack . --profile esm-only && node scripts/smoke-pack.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "bin": {
    "kr-job-parser": "./dist/cli/bin.js"
  },
  "homepage": "https://github.com/coddddin/job-alert-hub/tree/main/packages/kr-job-parser#readme",
  "bugs": {
    "url": "https://github.com/coddddin/job-alert-hub/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
