{
  "name": "@job-alert-hub/collector",
  "version": "0.1.0",
  "private": true,
  "description": "공공데이터 채용공고를 모아 Job Alert Hub 스냅샷과 kr-job-parser 해석 리포트를 만든다",
  "license": "MIT",
  "type": "module",
  "bin": { "job-alert-collect": "./dist/cli.js" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "collect": "node dist/cli.js"
  },
  "dependencies": {
    "kr-job-parser": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "engines": { "node": ">=22" }
}
